# gameagent 环境变量示例（无 .env 自动加载，需自行导出或经宿主注入）
# 复制为 .env 后按需修改

# mcpserver Streamable HTTP MCP 端点
MCP_URL=http://localhost:9090/mcp

# Agent 管理器 HTTP API 监听端口
MANAGER_PORT=9091

# LLM 模型提供方与模型 ID（prime-agent ModelRegistry 按 provider 查模型）
MODEL_PROVIDER=deepseek
MODEL_ID=deepseek-v4-flash

# 可选：覆盖模型实际请求的 endpoint（如 SiliconFlow 等 OpenAI 兼容网关），留空用模型默认
# 示例（SiliconFlow）：https://api.siliconflow.cn/v1
MODEL_BASE_URL=

# 可选：覆盖发给 API 的 model 字段（网关侧模型名），留空回退 MODEL_ID
# 示例（SiliconFlow）：deepseek-ai/DeepSeek-V4-Flash
MODEL_REQUEST_MODEL=

# DeepSeek API Key（注入 prime-agent 运行时会话）
DEEPSEEK_API_KEY=

# 种子 Agent 名单：逗号分隔，每项为 sid 或 sid:昵称（对齐 mcpserver AGENT_SEED_NAME 语义）
AGENT_SEED_NAMES=ai1:AgentAlpha,ai2:AgentBeta

# 子 session autonomous 引擎单次运行超时（毫秒）。
# 注意：不用于 checkTimeouts 强制回收（回收由下方双超时承担），仅作 prime-agent 引擎层超时
MAX_GAME_TIMEOUT_MS=1800000

# 子 Agent 空闲超时（毫秒）：run_cycle 周期进行中无任何心跳（LLM 回合挂起/卡死）超过则强制回收
CHILD_IDLE_TIMEOUT_MS=900000

# 单周期超时（毫秒）：run_cycle 周期总时长（含写脚本/批量对局/多轮复盘迭代）超过则强制回收
CYCLE_TIMEOUT_MS=7200000

# rlm.harness 分层记忆持久化路径
MEMORY_DB_PATH=./data/memories.json
