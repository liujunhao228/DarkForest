# 后端环境变量示例
# 复制为 .env 后按需修改;所有变量均有默认值,生产环境务必覆盖带密钥的项

# === Database (SQLite) ===
# 格式: sqlite://path/to/db（默认 sqlite://darkforest.db，相对 backend/ 工作目录）
DATABASE_URL=sqlite://darkforest.db

# === 迁移 ===
# golang-migrate 迁移文件目录(相对路径相对于 backend/ 工作目录)
MIGRATIONS_DIR=./internal/db/migrations

# === 本地信任模式（推荐路径，QQbot 本地方案）===
# 纯本地 QQbot / AI 代理接入推荐走此路径：开启后 /ws 路由切换为 trust-mode handler，
# 仅接受 127.0.0.1/::1 来源、按 ?qq=<n>&name=<nick>（或 ?sid=<agent>&name=<昵称>）自动注册账号、免 JWT。
# 未设或非 1 时行为完全不变（默认 JWT 路径）。
# LOCAL_TRUST_MODE=1
# trust-e2e（make trust-e2e）需要 DATABASE_URL 指向可写 SQLite 库（tests 用临时文件）

# === 密钥（仅非 trust/JWT 主路径使用）===
# ⚠ DEPRECATED：本地信任模式（LOCAL_TRUST_MODE=1）走上方推荐路径，无需 JWT_SECRET/ADMIN_SECRET_KEY；
# 仅在未设 LOCAL_TRUST_MODE（默认 JWT 网页端）时才需要。保留以实现旧路径完全兼容（Q3=B）。
# JWT 签名密钥
JWT_SECRET=your_jwt_secret_here
# 管理员初始化密钥
ADMIN_SECRET_KEY=your_admin_secret_here

# === Server ===
# HTTP 监听端口
PORT=8080
# 运行环境: development | production
ENVIRONMENT=development
# CORS 允许的来源,逗号分隔;留空则在开发模式下允许所有来源(*)
# 示例: https://app.example.com,https://admin.example.com
CORS_ALLOW_ORIGINS=

# === 静态资源 ===
# 前端构建产物目录(由后端作为静态资源服务)
STATIC_DIR=./frontend/dist
