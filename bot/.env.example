# bot <-> backend WS endpoint (LOCAL_TRUST_MODE)
BACKEND_WS_URL=ws://127.0.0.1:8080/ws

# bot listens here for SnowLuma reverse WS connection
BOT_WS_HOST=0.0.0.0
BOT_WS_PORT=8081

# OneBot 11 access_token for SnowLuma <-> bot handshake (empty = no auth)
ONEBOT_ACCESS_TOKEN=

# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# .match command defaults
DEFAULT_MATCH_COUNT=4
DEFAULT_MATCH_MODE=classic
MATCH_COUNT_MIN=2
MATCH_COUNT_MAX=5

# P3 starmap rendering
RENDER_CANVAS_SIZE=900
RENDER_FONT_PATH=C:\Windows\Fonts\msyh.ttc

# .log command defaults
LOG_DEFAULT_LIMIT=10
LOG_MAX_LIMIT=50

# .state command: how long to wait for a fullSync reply when cache is empty (seconds)
STATE_REQUEST_TIMEOUT=10.0

# P4 game action commands: how long to wait for a game:error reply before assuming success (seconds)
ACTION_ERROR_TIMEOUT=2.0

# 群聊中是否要求@机器人才响应命令（true/false）。SnowLuma @ 解析异常时可设 false 回退。
GROUP_REQUIRE_AT_MENTION=false

# .analyse 复盘分析：analyser CLI 的 MCP 端点 / 可执行文件 / 工作目录 / 超时（秒）
# ANALYSE_CWD 必须指向 analyser 包根目录（其 Settings 相对 cwd 读 .env 的 LLM 配置）
# 一次分析 = 3 阶段并行 + 汇总，共多次 LLM 调用，默认给足 600s
ANALYSE_MCP_URL=http://localhost:9090/mcp
ANALYSE_BIN=analyser
ANALYSE_CWD=
ANALYSE_TIMEOUT=600.0

# .playai 命令：gameagent Agent 管理器 HTTP API 基址与轮询超时（秒）
AGENT_MANAGER_URL=http://localhost:9091
