# orchestrator 环境变量（宿主注入，本文件不会被自动加载）
#
# 由 scripts/up.ps1 统一派生注入；本地直跑时手动 export。

# HTTP 服务端口（默认 9092）
ORCHESTRATOR_PORT=9092

# deepseek-harness 根目录（dsh CLI 所在）
DSH_ROOT=E:/deepseek-harness

# dsh CLI profile 名（默认 darkforest）
DF_PROFILE=darkforest

# 可分配的 AI 玩家 sid 池（逗号分隔）。
# 必须与 mcpserver AGENT_SEED_NAME 同源对齐，否则 spawn 后 "account not in pool"。
# 由 up.ps1 从 scripts/trust-local.env 的昵称派生（agt_<name>_N）。
ORCHESTRATOR_SEED_SIDS=ai1,ai2,ai3,ai4,ai5,ai6,ai7,ai8,ai9,ai10,ai11,ai12
